{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["DATABASE_URL"],
      "passThroughEnv": ["JWT_ACCESS_SECRET", "JWT_REFRESH_PEPPER"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"],
      "passThroughEnv": ["JWT_ACCESS_SECRET", "JWT_REFRESH_PEPPER"]
    }
  }
}
