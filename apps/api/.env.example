# Copy to .env for local development. Never commit .env (ADR 0018).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://skillboard:skillboard@localhost:5432/skillboard
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
# Signs access tokens (ADR 0009). At least 32 characters; generate one with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=local-dev-only-secret-change-me-please-0123456789
# Access-token lifetime in seconds (default 900 = 15 min).
JWT_ACCESS_TTL_SECONDS=900
# Mixed into the hash of refresh, verification and reset tokens (ADR 0020). At least 32 characters; a
# different value from JWT_ACCESS_SECRET. Changing it signs everyone out.
JWT_REFRESH_PEPPER=local-dev-only-pepper-change-me-please-0123456789
# Refresh token lifetime in days (1-90, default 30) and the concurrent-refresh grace in seconds (0-120).
REFRESH_TTL_DAYS=30
REFRESH_GRACE_SECONDS=30
# `console` prints the verification and reset links in the API log (development and test only);
# `resend` sends real email and needs RESEND_API_KEY and a verified sender in EMAIL_FROM.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM=SkillBoard Korea <noreply@localhost>
# Google sign-in is on only when all three are set (Google Cloud console > APIs > Credentials, OAuth client).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
# Turns the rate limiter off. Only for the Playwright run (it signs in dozens of times from one IP);
# the API refuses to boot with it in production.
# RATE_LIMIT_DISABLED=false
