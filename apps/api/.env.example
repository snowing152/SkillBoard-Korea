# Copy to .env for local development. Never commit .env (ADR 0018).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://skillboard:skillboard@localhost:5432/skillboard
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
# Signs access tokens (ADR 0009). At least 32 characters; generate one with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=local-dev-only-secret-change-me-please-0123456789
# Access-token lifetime in seconds (default 900 = 15 min).
JWT_ACCESS_TTL_SECONDS=900
