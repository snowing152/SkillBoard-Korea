// Prisma 7 schema (ADR 0005). DATABASE_URL is configured in ../prisma.config.ts, not here.
// Plain-words description of every model: docs/domain.md. Conventions (.claude/rules/prisma.md):
// UUID v7 ids, UTC timestamps, Cascade from User for personal data, SetNull for audit rows (ADR 0018).

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Enums only for sets the code reasons about. Content sets (skills) are tables.
enum UserRole {
  TALENT
  CLIENT
  ADMIN
}

enum AuthProvider {
  GOOGLE
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  OAUTH_EXCHANGE
}

enum ConsentType {
  TERMS
  PRIVACY
  VISA_DISCLAIMER
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
}

enum WorkMode {
  REMOTE
  ON_SITE
  HYBRID
}

enum LanguageLevel {
  NATIVE
  FLUENT
  INTERMEDIATE
  BASIC
}

enum ContactType {
  EMAIL
  TELEGRAM
  KAKAO
}

enum ReportReason {
  SPAM
  SCAM
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE
  UNHIDE
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique // stored lower-cased by the service
  emailVerifiedAt DateTime?
  passwordHash    String? // argon2id; null = Google-only account
  displayName     String
  locale          String     @default("en") // UI language; validated against the shared locale list
  roles           UserRole[] @default([])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  identities         AuthIdentity[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  consents           Consent[]
  talentProfile      TalentProfile?
  reportsFiled       Report[]            @relation("ReportReporter")
  reportsResolved    Report[]            @relation("ReportResolver")
  contactReveals     ContactReveal[]
  moderationActions  ModerationAction[]
}

model AuthIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  provider       AuthProvider
  providerUserId String
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique // sha256 of the opaque token
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  rotatedAt DateTime? // set when /refresh exchanged it for the next token; presenting it again is replay
  revokedAt DateTime? // set on purpose (logout, password change or reset, theft response); plain 401
  createdAt DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  tokenHash String       @unique
  purpose   TokenPurpose
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

model Consent {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ConsentType
  version    String // e.g. "2026-10-01"; matches the legal page version
  locale     String      @default("en") // UI language when accepted; validated against LOCALES in shared
  acceptedAt DateTime    @default(now())

  @@unique([userId, type, version])
}

model TalentProfile {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @unique @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String        @unique // public URL /t/{slug}
  headline     String // limits enforced by the Zod schema in packages/shared
  description  String
  photoUrl     String?
  videoUrl     String? // external link only (YouTube etc.)
  cityCode     String? // from the shared CITY_CODES list
  workMode     WorkMode      @default(HYBRID)
  visaType     String? // self-declared; from the shared VISA_TYPES list
  status       ProfileStatus @default(DRAFT)
  publishedAt  DateTime?
  hiddenAt     DateTime? // set by an admin; non-null = hidden from the public
  hiddenReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  skills            TalentSkill[]
  languages         TalentLanguage[]
  portfolioLinks    PortfolioLink[]
  contactMethods    ContactMethod[]
  contactReveals    ContactReveal[]
  reports           Report[]
  moderationActions ModerationAction[]

  // Search filters hit these. The composite covers the "publicly visible" predicate plus recency sort.
  @@index([status, hiddenAt, publishedAt(sort: Desc)])
  @@index([cityCode])
  @@index([workMode])
  @@index([visaType])
}

model SkillCategory {
  id        String  @id @default(uuid(7)) @db.Uuid
  slug      String  @unique // "tutoring", "marketing", "creative", "language-services"
  names     Json // { "en": "Tutoring", "ko": "...", "ru": "..." }
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  skills    Skill[]
}

model Skill {
  id         String        @id @default(uuid(7)) @db.Uuid
  slug       String        @unique // "russian-tutor", "smm", "video-editing"
  names      Json
  categoryId String        @db.Uuid
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  sortOrder  Int           @default(0)
  isActive   Boolean       @default(true)
  talents    TalentSkill[]
}

model TalentSkill {
  profileId String        @db.Uuid
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String        @db.Uuid
  skill     Skill         @relation(fields: [skillId], references: [id])
  sortOrder Int           @default(0)

  @@id([profileId, skillId])
  @@index([skillId])
}

model TalentLanguage {
  profileId    String        @db.Uuid
  profile      TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  languageCode String // ISO 639-1: "ru", "en", "ko"
  level        LanguageLevel

  @@id([profileId, languageCode])
  @@index([languageCode])
}

model PortfolioLink {
  id        String        @id @default(uuid(7)) @db.Uuid
  profileId String        @db.Uuid
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  sortOrder Int           @default(0)
}

model ContactMethod {
  id        String        @id @default(uuid(7)) @db.Uuid
  profileId String        @db.Uuid
  profile   TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      ContactType
  value     String // email address, @telegram, kakao id

  @@unique([profileId, type])
}

model ContactReveal {
  id           String        @id @default(uuid(7)) @db.Uuid
  profileId    String        @db.Uuid
  profile      TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  viewerUserId String?       @db.Uuid // null after the viewer deletes their account
  viewer       User?         @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([profileId, createdAt])
  @@index([viewerUserId, createdAt])
}

model Report {
  id             String        @id @default(uuid(7)) @db.Uuid
  profileId      String        @db.Uuid
  profile        TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reporterUserId String?       @db.Uuid
  reporter       User?         @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reason         ReportReason
  details        String? // max 1000 chars (Zod)
  status         ReportStatus  @default(OPEN)
  resolvedById   String?       @db.Uuid
  resolvedBy     User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([profileId])
}

model ModerationAction {
  id          String               @id @default(uuid(7)) @db.Uuid
  profileId   String               @db.Uuid
  profile     TalentProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  adminUserId String?              @db.Uuid
  admin       User?                @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      ModerationActionType
  reason      String
  createdAt   DateTime             @default(now())

  @@index([profileId, createdAt])
}
