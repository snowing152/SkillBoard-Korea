{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "build": { "dependsOn": ["^build", "db:generate"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build", "db:generate"] },
    "lint": { "dependsOn": ["^build", "db:generate"] },
    "test": { "dependsOn": ["^build", "db:generate"] },
    "dev": { "dependsOn": ["^build", "db:generate"], "cache": false, "persistent": true }
  }
}
