# Copy to .env.local for local development. Never commit .env* files (ADR 0018).
# Browser-side API base URL (inlined at build time; must start with NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side API base URL (Server Components). Defaults to NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:3001
# Show the "Continue with Google" button ('true' | 'false', default 'false'). Needs GOOGLE_* set on the API.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
