{
  "name": "@skillboard/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, inferred types and constants shared by web, api and the future mobile app. Pure TypeScript: no Node, no DOM.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@skillboard/config": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
